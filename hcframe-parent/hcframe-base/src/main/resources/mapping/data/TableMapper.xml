<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.taixingyiji.base.module.data.dao.TableMapper">
    <select id="findAllTables" resultType="map">
        select *
        FROM ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
    </select>
    <select id="findAllTablesWithField" resultType="java.util.Map">
        select ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quoteFieldList(fields)}
        FROM ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
    </select>
    <select id="findByEqual" resultType="map" parameterType="map">
        select *
        FROM ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
        <where>
            <foreach collection="info.keys"
                     separator=" and "
                     item="key">
                <if test="info[key]!=null and info[key]!=''">
                    <bind name="value" value="info[key]"/>
                    ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(key)}=#{value}
                </if>
            </foreach>
        </where>
    </select>

    <select id="findByLike" resultType="map" parameterType="map">
        select *
        FROM ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
        <where>
            <foreach collection="info.keys"
                     separator=" and "
                     item="key">
                <if test="info[key]!=null and info[key]!=''">
                    <bind name="value" value="'%' + info[key] + '%'"/>
                    ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(key)} like #{value}
                </if>
            </foreach>
        </where>
    </select>

    <delete id="deleteByPrimary">
        DELETE FROM ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
        WHERE ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(pkName)} in
        <foreach collection="ids"
                 open="("
                 close=")"
                 separator=","
                 item="item">
            #{item}
        </foreach>
    </delete>


    <insert id="saveInfo" parameterType="map" useGeneratedKeys="true" keyProperty="info.id" keyColumn="id">
        INSERT INTO ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
        <foreach collection="info" open="(" close=")" separator="," item="value" index="key">
            <if test="info[key]!=null and info[key]!=''">
                ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(key)}
            </if>
        </foreach>
        VALUES
        <foreach collection="info" open="(" close=")" separator="," item="value" index="key">
            <if test="info[key]!=null and info[key]!=''">
                #{value}
            </if>
        </foreach>
    </insert>

    <insert id="saveInfoWithNull" parameterType="map" useGeneratedKeys="true" keyProperty="info.id" keyColumn="id">
        INSERT INTO ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
        <foreach collection="info.keys" open="(" close=")" separator="," item="key" index="index">
            ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(key)}
        </foreach>
        VALUES
        <foreach collection="info.entrySet()" open="(" close=")" separator="," index="key" item="value">
            #{value}
        </foreach>
    </insert>
    <insert id="saveInfoWithOracle" parameterType="map" >
        INSERT INTO ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
        <foreach collection="info.keys" open="(" close=")" separator="," item="key" index="index">
            ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(key)}
        </foreach>
        VALUES
        <foreach collection="info.entrySet()" open="(" close=")" separator="," index="key" item="value">
            #{value}
        </foreach>
    </insert>

    <update id="updateInfo" parameterType="map">
        update ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
        <set>
            <foreach collection="info" separator="," item="value" index="key">
                ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(key)} = #{value}
            </foreach>
        </set>
        where ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote('id')} = #{info.id}
    </update>
    <update id="updateInfoWithNull" parameterType="map" >
        update ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
        <set>
            <foreach collection="info" separator="," item="value" index="key">
                <if test="key!='id'">
                    ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(key)} = #{value}
                </if>
            </foreach>
        </set>
        where ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote('id')} = #{info.id}
    </update>

    <update id="updateByWhere" parameterType="map" >
        update ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
        <set>
            <foreach collection="info" separator="," item="value" index="key">
                ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(key)} = #{value}
            </foreach>
        </set>
        ${sql}
    </update>

    <update id="updateByWhereWithNull" parameterType="map">
        update ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
        <set>
            <foreach collection="info" separator="," item="value" index="key">
                <if test="key!='id'">
                    ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(key)} = #{value}
                </if>
            </foreach>
        </set>
        where ${sql}
    </update>
    <delete id="deleteByWhere">
        DELETE
        FROM ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)} ${sql}
    </delete>
    <select id="useSql" resultType="java.util.Map">
        ${sql}
    </select>
    <select id="userSqlByOne" resultType="java.util.Map">
        ${sql}
    </select>
    <select id="useSqlByTest" resultType="java.lang.Object">
        ${sql}
    </select>
    <select id="getListNoPage" resultType="java.util.Map">
        select * from ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(typeName)}
        where 1=1
        <foreach collection="info" separator="," item="value" index="key">
            and ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(key)} = #{value}
        </foreach>
    </select>




    <select id="getSequence" resultType="java.lang.Object">
        select ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quoteWithSuffix(tableName, '_seq')}.nextval
        from dual
    </select>
    <select id="getHighGoSequence" resultType="java.lang.Object">
        <bind name="sequenceName"
              value="@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@normalizeWithSuffix(tableName, '_seq')"/>
        select nextval(#{sequenceName})
    </select>
    <insert id="createSequence">
        CREATE
        SEQUENCE ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quoteWithSuffix(tableName, '_seq')}
        MINVALUE 1
        NOMAXVALUE
        START
        WITH ${lastId}
        INCREMENT BY 1
        NOCACHE
    </insert>
    <insert id="createHighGoSequence">
        CREATE SEQUENCE ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quoteWithSuffix(tableName, '_seq')}
        MINVALUE 1
        NO MAXVALUE
        START WITH ${lastId}
        INCREMENT BY 1
        CACHE 1;
    </insert>
    <update id="setValForHighGoSequence">
        <bind name="sequenceName"
              value="@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@normalizeWithSuffix(tableName, '_seq')"/>
        SELECT setval(#{sequenceName},
            (SELECT COALESCE(MAX(${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(pkName)}),0) + 1
             FROM ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}), false);
    </update>
    <!-- 获取锁 -->
    <update id="lockSequence">
        <bind name="sequenceName"
              value="@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@normalizeWithSuffix(tableName, '_seq')"/>
        SELECT pg_advisory_lock(hashtext(#{sequenceName}));
    </update>

    <!-- 释放锁 -->
    <update id="unlockSequence" >
        <bind name="sequenceName"
              value="@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@normalizeWithSuffix(tableName, '_seq')"/>
        SELECT pg_advisory_unlock(hashtext(#{sequenceName}));
    </update>
    <update id="lockSequenceDm">
        DECLARE
            lock_handle VARCHAR2(128);
            result INT;
        BEGIN
            <bind name="sequenceName"
                  value="@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@normalizeWithSuffix(tableName, '_seq')"/>
            DBMS_LOCK.ALLOCATE_UNIQUE(#{sequenceName},lock_handle);
            result:=DBMS_LOCK.REQUEST(lock_handle,DBMS_LOCK.X_MODE,10);
            IF result &lt; 0 THEN
                RAISE_APPLICATION_ERROR(-20001,'获取锁失败');
            END IF;
        END;
    </update>

    <update id="unlockSequenceDm">
        DECLARE
            lock_handle VARCHAR2(128);
        BEGIN
            <bind name="sequenceName"
                  value="@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@normalizeWithSuffix(tableName, '_seq')"/>
            DBMS_LOCK.ALLOCATE_UNIQUE(#{sequenceName},lock_handle);
            DBMS_LOCK.RELEASE(lock_handle);
        END;
    </update>
    <update id="createSequenceSafeDm">
        <bind name="quotedSequenceName"
              value="@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quoteWithSuffix(tableName, '_seq')"/>
        DECLARE
            v_start NUMBER;
            lock_handle VARCHAR2(128);
            lock_name VARCHAR2(128);
        BEGIN
            lock_name := 'SEQ_LOCK_' || #{tableName};
            DBMS_LOCK.ALLOCATE_UNIQUE(lock_name, lock_handle);

            SELECT NVL(MAX(${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(pkName)}),0)+1
            INTO v_start FROM ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)};
            DBMS_LOCK.ALLOCATE_UNIQUE('CAPTCHA_CODE_seq',lock_handle);
            BEGIN
                EXECUTE IMMEDIATE 'CREATE SEQUENCE '
                    || #{quotedSequenceName}
                    || ' START WITH ' || v_start || ' INCREMENT BY 1 NOCACHE';
            EXCEPTION
                WHEN OTHERS THEN
                    NULL;--序列已存在静默忽略
            END;
            -- 后续创建序列业务逻辑
            DBMS_LOCK.RELEASE(lock_handle);
        END;
    </update>
    <select id="judgeHighGoSequenceExist" resultType="boolean">
        <bind name="sequenceName"
              value="@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@normalizeWithSuffix(tableName, '_seq')"/>
        SELECT EXISTS (
            SELECT 1
            FROM pg_class
            WHERE relkind = 'S'
              AND relname = #{sequenceName}
              AND pg_table_is_visible(oid)
        );
    </select>
    <select id="judgeDamengSequenceExist" resultType="int">
        <bind name="sequenceName"
              value="@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@normalizeWithSuffix(tableName, '_seq')"/>
        SELECT COUNT(*)
        FROM all_sequences
        WHERE sequence_owner = #{schema}
          AND sequence_name = #{sequenceName}
    </select>
    <select id="count" resultType="java.lang.Long">
        SELECT count(0) FROM ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)} ${sql}
    </select>
    <select id="countBySql" resultType="java.lang.Long">
        ${sql}
    </select>
    <insert id="insertBatch" parameterType="map">
        INSERT INTO ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <foreach collection="list[0].keySet()" item="column" separator=",">
                ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(column)}
            </foreach>
        </trim>
        VALUES
        <foreach collection="list" item="row" separator=",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                <foreach collection="row" item="value" separator=",">
                    #{value}
                </foreach>
            </trim>
        </foreach>
    </insert>
    <insert id="insertBatchSeq" parameterType="map">
        INSERT INTO ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(tableName)}
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <foreach collection="list[0].keySet()" item="column" separator=",">
                ${@com.taixingyiji.base.module.data.module.SqlIdentifierQuoter@quote(column)}
            </foreach>
        </trim>
        VALUES
        <foreach collection="list" item="row" separator=",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                <foreach collection="row" item="value" index="key" separator=",">
                    <choose>
                        <when test="key == pkName">
                            ${value}
                        </when>
                        <otherwise>
                            #{value}
                        </otherwise>
                    </choose>
                </foreach>
            </trim>
        </foreach>
    </insert>
    <update id="updateBatchByPk" parameterType="map">
        ${sql}
    </update>
</mapper>
